# Foran Delivery MCP — environment (copy to .env for the hosted HTTP server)

# Required for the hosted server: 32+ random characters. Seals customer session keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORAN_MCP_SECRET=

# HTTP mode
MCP_TRANSPORT=http
HOST=127.0.0.1
PORT=8095
ALLOWED_HOSTS=mcp.forandelivery.com

# Optional
FORAN_API_BASE=https://admin.forandelivery.com
FORAN_SESSION_DAYS=7

# Optional, LOCAL stdio use only: log in without typing the password in chat
# FORAN_PHONE=03001234567
# FORAN_PASSWORD=

# Claude orders (custom orders + live status). Same value as FORAN_CLAUDE_KEY in the Foran admin .env.
FORAN_CLAUDE_KEY=
# Foran team passphrase for foran_staff_login (12+ characters). Leave empty to disable staff tools.
FORAN_STAFF_KEY=
